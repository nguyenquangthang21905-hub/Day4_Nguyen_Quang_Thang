@model Day4.Models.Product

@{
    ViewData["Title"] = "Product Details";
}

<h1>Product Details</h1>
<hr />
<dl class="row">
    <dt class="col-sm-2">Name</dt>
    <dd class="col-sm-10">@Model.ProductName</dd>
    <dt class="col-sm-2">Price</dt>
    <dd class="col-sm-10">@Model.Price.ToString("C")</dd>
    <dt class="col-sm-2">Category</dt>
    <dd class="col-sm-10">@ViewBag.CategoryName</dd>
</dl>
<div>
    <a asp-action="Edit" asp-route-id="@Model.ProductId" class="btn btn-primary">Edit</a>
    <a asp-action="Index" class="btn btn-secondary">Back to List</a>
</div>
